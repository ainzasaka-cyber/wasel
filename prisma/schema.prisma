generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus { ACTIVE SUSPENDED CLOSED }
enum Language { fr ar }
enum PlatformType { CUSTOM_API SHOPIFY WOOCOMMERCE MANUAL }
enum StoreStatus { ACTIVE PAUSED DISCONNECTED }
enum Role { SUPER_ADMIN STORE_OWNER STORE_STAFF CONFIRMATION_AGENT DISPATCHER COURIER }
enum OrderStatus { ORDER_RECEIVED CONFIRMATION_PENDING CONFIRMED PREPARING READY_FOR_PICKUP PICKED_UP IN_TRANSIT OUT_FOR_DELIVERY DELIVERED CANCELLED DELIVERY_FAILED RESCHEDULED RETURNED }
enum Priority { LOW NORMAL HIGH URGENT }
enum PaymentMethod { COD PREPAID }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }
enum ActorType { USER SYSTEM API_KEY COURIER CUSTOMER }

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  status          TenantStatus @default(ACTIVE)
  defaultCurrency String       @default("MAD") @db.Char(3)
  defaultLanguage Language     @default(fr)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  stores          Store[]
  memberships     TenantMembership[]
  products        Product[]
  customers       Customer[]
  orders          Order[]
  orderEvents     OrderEvent[]
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  passwordHash    String
  fullName        String
  locale          Language     @default(fr)
  failedLoginCount Int         @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     TenantMembership[]
  sessions        Session[]
  orderEvents     OrderEvent[]
}

model TenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId, role])
  @@index([userId, role])
  @@index([tenantId, role])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Store {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  name         String
  code         String
  domain       String?
  platformType PlatformType
  status       StoreStatus  @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products     Product[]
  orders       Order[]
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  sku         String
  name        String
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  @@unique([tenantId, sku])
  @@index([tenantId, active])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  fullName       String
  phone          String
  normalizedPhone String
  email          String?
  city           String
  region         String?
  district       String?
  address        String?
  addressNotes   String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  @@unique([tenantId, normalizedPhone])
  @@index([tenantId, city])
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  storeId         String        @db.Uuid
  customerId      String        @db.Uuid
  orderNumber     String
  externalOrderId String?
  status          OrderStatus   @default(ORDER_RECEIVED)
  priority        Priority      @default(NORMAL)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  currency        String        @default("MAD") @db.Char(3)
  subtotal        Decimal       @db.Decimal(12, 2)
  deliveryFee     Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  codAmount       Decimal       @db.Decimal(12, 2)
  itemCount       Int
  notes           String?
  internalNotes  String?
  deliveryCity    String
  trackingToken   String        @unique @db.VarChar(64)
  placedAt        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  events          OrderEvent[]
  @@unique([tenantId, orderNumber])
  @@unique([tenantId, externalOrderId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, deliveryCity])
  @@index([storeId, status])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  productId   String?  @db.Uuid
  sku         String
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model OrderEvent {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  orderId       String      @db.Uuid
  eventType     String
  previousStatus OrderStatus?
  newStatus     OrderStatus
  actorType     ActorType
  actorUserId   String?     @db.Uuid
  metadata      Json?
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorUser     User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([orderId, createdAt])
  @@index([tenantId, createdAt])
}
