{
  "openapi": "3.1.0",
  "info": { "title": "WASEL API", "version": "1.0.0", "description": "Versioned order, shipment, dispatch, audit, tracking, and settlement-exposure APIs for WASEL. Authentication uses sessions for the operator console and API keys for external integrations. Workspace selection is an operator-console route outside this versioned API document." },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": { "get": { "security": [], "responses": { "200": { "description": "Service health" }, "503": { "description": "Database unavailable" } } } },
    "/openapi.json": { "get": { "security": [], "responses": { "200": { "description": "OpenAPI document" } } } },
    "/orders": { "get": { "responses": { "200": { "$ref": "#/components/responses/ListResponse" }, "401": { "$ref": "#/components/responses/ErrorResponse" }, "403": { "$ref": "#/components/responses/ErrorResponse" } } }, "post": { "responses": { "201": { "description": "Order created" }, "409": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/orders/{orderId}": { "get": { "parameters": [{ "$ref": "#/components/parameters/OrderId" }], "responses": { "200": { "description": "Tenant-scoped order detail" }, "404": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/orders/{orderId}/status": { "get": { "parameters": [{ "$ref": "#/components/parameters/OrderId" }], "responses": { "200": { "description": "Role-allowed transitions" }, "403": { "$ref": "#/components/responses/ErrorResponse" } } }, "post": { "parameters": [{ "$ref": "#/components/parameters/OrderId" }], "responses": { "200": { "description": "Status changed and event appended" }, "409": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/orders/{orderId}/confirmation": { "post": { "parameters": [{ "$ref": "#/components/parameters/OrderId" }], "responses": { "200": { "description": "Confirmation action applied" }, "409": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/shipments": { "get": { "responses": { "200": { "description": "Tenant-scoped shipment queue" }, "403": { "$ref": "#/components/responses/ErrorResponse" } } }, "post": { "responses": { "201": { "description": "Shipment created for an order" }, "409": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/shipments/{shipmentId}/status": { "post": { "parameters": [{ "$ref": "#/components/parameters/ShipmentId" }], "responses": { "200": { "description": "Shipment transition with optional delivery attempt and POD" }, "409": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/shipments/{shipmentId}/assign": { "post": { "parameters": [{ "$ref": "#/components/parameters/ShipmentId" }], "responses": { "200": { "description": "Courier assignment created" }, "403": { "$ref": "#/components/responses/ErrorResponse" }, "409": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/audit": { "get": { "parameters": [{ "name": "entityType", "in": "query", "schema": { "type": "string" } }, { "name": "action", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/ListResponse" }, "403": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/dispatch": { "get": { "responses": { "200": { "description": "Tenant-scoped dispatch queue" }, "403": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/settlements/exposure": { "get": { "responses": { "200": { "description": "Read-only order-level COD exposure. This is not a collected-COD ledger, reconciled settlement batch, or merchant payout." }, "403": { "$ref": "#/components/responses/ErrorResponse" } } } },
    "/tracking/{token}": { "get": { "security": [], "parameters": [{ "$ref": "#/components/parameters/TrackingToken" }], "responses": { "200": { "description": "Customer-safe tracking response" }, "404": { "$ref": "#/components/responses/ErrorResponse" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "wasel_live_prefix_secret" } },
    "parameters": { "OrderId": { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, "ShipmentId": { "name": "shipmentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, "TrackingToken": { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } } },
    "responses": { "ErrorResponse": { "description": "Stable WASEL error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "ListResponse": { "description": "Cursor-paginated result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/List" } } } } },
    "schemas": { "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "details"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": "object" } } } } }, "List": { "type": "object", "required": ["data", "page"], "properties": { "data": { "type": "array", "items": {} }, "page": { "type": "object", "required": ["nextCursor", "hasMore", "limit"], "properties": { "nextCursor": { "type": ["string", "null"] }, "hasMore": { "type": "boolean" }, "limit": { "type": "integer" } } } } } }
  }
}
